model WmsTenantMembership {
  id String @id @default(cuid())

  tenantId String
  userId   String

  isTenantAdmin Boolean @default(false)
  isActive      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant WmsTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId], name: "wms_tenant_user_unique")
  @@index([userId, isActive])
  @@index([tenantId, isActive])
}

model UserCompanyAccess {
  id String @id @default(cuid())

  tenantId  String
  companyId String
  userId    String

  canView    Boolean @default(true)
  canOperate Boolean @default(true)
  canManage  Boolean @default(false)

