  updatedAt DateTime @updatedAt

  tenant  WmsTenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company WmsCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId], name: "wms_company_user_unique")
  @@index([tenantId, userId, isActive])
  @@index([companyId, isActive])
  @@index([userId, isDefault])
}

model UserWarehouseAccess {
  id String @id @default(cuid())

  tenantId    String
  warehouseId Int
  userId      String

  canView    Boolean @default(true)
  canOperate Boolean @default(true)
  canManage  Boolean @default(false)

  isDefault Boolean @default(false)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    WmsTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, userId], name: "wms_warehouse_user_unique")
  @@index([tenantId, userId, isActive])
  @@index([warehouseId, isActive])
  @@index([userId, isDefault])
}

enum UserStatus {
  ACTIVE
  PASSIVE
  LOCKED
  SUSPENDED
}

enum CustomerUserRole {
  CUSTOMER_ADMIN
  BUYER
  ADDRESS_USER
}

enum UserType {
  ADMIN
  OFFICE
  WAREHOUSE
  RF_OPERATOR
  SYSTEM
  CUSTOMER
  API
}

enum AuthSessionType {
  WEB
  RF
  API
}

model Employee {
  id String @id @default(cuid())

  employeeCode String @unique

  firstName String
  lastName  String

  email String? @unique
  phone String?

  department String?
  title      String?
  shiftCode  String?

  hireDate        DateTime?
  terminationDate DateTime?

  isActive Boolean @default(true)
  canUseRf Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User?

  @@index([isActive])
  @@index([canUseRf])
  @@index([department])
  @@index([firstName, lastName])
}

model User {
  id String @id @default(cuid())

  employeeId String? @unique
  customerId Int?

  username String  @unique
  email    String? @unique
  fullName String?

  passwordHash String

  userType     UserType          @default(WAREHOUSE)
  status       UserStatus        @default(ACTIVE)
  customerRole CustomerUserRole?

  mustChangePassword Boolean @default(true)
  failedLoginCount   Int     @default(0)

  lastLoginAt          DateTime?
  passwordChangedAt    DateTime?
  lockedAt             DateTime?
  lastFailedLoginAt    DateTime?
  sessionInvalidatedAt DateTime?

  isRfUser    Boolean @default(false)
  isAdminUser Boolean @default(false)

  createdById String?
  updatedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  createdBy    User?  @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers User[] @relation("UserCreatedBy")

  updatedBy    User?  @relation("UserUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedUsers User[] @relation("UserUpdatedBy")

  userRoles         UserRole[]
  assignedUserRoles UserRole[] @relation("UserRoleAssignedBy")

  waveAssignments   WaveAssignment[]
  assignedWaveTasks WaveAssignment[] @relation("WaveAssignmentAssignedBy")

  authSessions        AuthSession[]
  passwordResetTokens PasswordResetToken[]
  placedOrders        Order[]              @relation("OrderPlacedByUser")

  customerAddressAccesses         CustomerUserAddressAccess[] @relation("CustomerUserAddressAccessUser")
  assignedCustomerAddressAccesses CustomerUserAddressAccess[] @relation("CustomerUserAddressAccessAssignedBy")

  wmsTenantMemberships WmsTenantMembership[]
  wmsCompanyAccesses   UserCompanyAccess[]
  wmsWarehouseAccesses UserWarehouseAccess[]

  createdInventoryCounts    InventoryCount[]         @relation("InventoryCountCreatedBy")
  approvedInventoryCounts   InventoryCount[]         @relation("InventoryCountApprovedBy")
  cancelledInventoryCounts  InventoryCount[]         @relation("InventoryCountCancelledBy")
  inventoryCountAssignments InventoryCountAssignee[] @relation("InventoryCountAssigneeUser")
  assignedInventoryCounts   InventoryCountAssignee[] @relation("InventoryCountAssigneeAssignedBy")
  countedInventoryLocations InventoryCountLocation[] @relation("InventoryCountLocationCountedBy")
  countedInventoryLines     InventoryCountLine[]     @relation("InventoryCountLineCountedBy")

  @@index([employeeId])
  @@index([customerId, status])
  @@index([customerId, customerRole, status])
  @@index([status])
  @@index([userType])
  @@index([isRfUser])
  @@index([isAdminUser])
  @@index([createdById])
  @@index([updatedById])
}

model AuthSession {
  id String @id @default(cuid())

  userId String

  /**
   * Gerçek oturum anahtarı veritabanında tutulmaz.
   * Yalnızca SHA-256 özeti saklanır.
   */
  tokenHash String @unique

  sessionType AuthSessionType @default(WEB)

  /**
   * RF oturumlarında cihaz veya terminal kodu.
   */
  terminalCode String?

  /**
   * İstek kaynağına ait teknik bilgiler.
   */
  ipAddress String?
  userAgent String?

  /**
   * Oturumun son geçerlilik zamanı.
   */
  expiresAt DateTime

  /**
   * Kullanıcının en son aktif olduğu zaman.
   */
  lastActivityAt DateTime @default(now())

  /**
   * Oturum kullanıcı çıkışı veya yönetici işlemiyle
   * geçersiz kılındığında doldurulur.
   */
  revokedAt    DateTime?
  revokeReason String?
  revokedById  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionType])
  @@index([expiresAt])
  @@index([revokedAt])
  @@index([lastActivityAt])
  @@index([terminalCode])
}

model PasswordResetToken {
  id String @id @default(cuid())

  userId    String
  tokenHash String @unique

  expiresAt DateTime
  usedAt    DateTime?

  requestedIpAddress String?
  requestedUserAgent String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@index([usedAt])
}

model Role {
  id String @id @default(cuid())

  code String @unique
  name String @unique

  description String?

  isSystemRole Boolean @default(false)
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@index([isActive])
  @@index([isSystemRole])
}

model Permission {
  id String @id @default(cuid())

  code String @unique
  name String

  module      String
  description String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rolePermissions RolePermission[]

  @@index([module])
  @@index([isActive])
}

model UserRole {
  id String @id @default(cuid())

  userId String
  roleId String

  assignedById String?
  assignedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  assignedBy User? @relation("UserRoleAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([userId, roleId], name: "user_role_unique")
  @@index([userId])
  @@index([roleId])
  @@index([assignedById])
}

model RolePermission {
  id String @id @default(cuid())

  roleId       String
  permissionId String

  grantedAt DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId], name: "role_permission_unique")
  @@index([roleId])
  @@index([permissionId])
}

model WaveAssignment {
  id String @id @default(cuid())

  waveId String
  userId String

  operationType WmsOperationType?
  status        WaveAssignmentStatus @default(ASSIGNED)

  assignedAt     DateTime  @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  lastActivityAt DateTime?

  assignedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wave Wave @relation(fields: [waveId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  assignedBy User? @relation("WaveAssignmentAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([waveId, userId, operationType], name: "wave_user_operation_unique")
  @@index([waveId, status])
  @@index([userId, status])
  @@index([assignedById])
  @@index([operationType])
}

enum InventoryCountScope {
  ALL_LOCATIONS
  SELECTED_LOCATIONS
}

enum InventoryCountStatus {
  DRAFT
  ACTIVE
  IN_PROGRESS
  SUBMITTED
  APPROVED
  CANCELLED
}

enum InventoryCountLocationStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum InventoryCountLineStatus {
  PENDING
  COUNTED
  RECOUNT_REQUIRED
  APPROVED
}

model InventoryCount {
  id          Int                  @id @default(autoincrement())
  countNumber String               @unique
  warehouseId Int
  scope       InventoryCountScope
  status      InventoryCountStatus @default(DRAFT)

  notes String?

  snapshotAt  DateTime?
  startedAt   DateTime?
  submittedAt DateTime?
  approvedAt  DateTime?
  cancelledAt DateTime?

  createdById   String
  createdByName String

  approvedById   String?
  approvedByName String?

  cancelledById   String?
  cancelledByName String?
  cancelReason    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  createdBy   User  @relation("InventoryCountCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy  User? @relation("InventoryCountApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  cancelledBy User? @relation("InventoryCountCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)

  locations InventoryCountLocation[]
  lines     InventoryCountLine[]
  assignees InventoryCountAssignee[]

  @@index([warehouseId, status])
  @@index([status, createdAt])
  @@index([countNumber])
  @@index([createdById])
  @@index([approvedById])
  @@index([cancelledById])
}

model InventoryCountAssignee {
  id               Int    @id @default(autoincrement())
  inventoryCountId Int
  userId           String

  username     String
  employeeCode String?
  fullName     String

  assignedById   String
  assignedByName String
  assignedAt     DateTime @default(now())

  inventoryCount InventoryCount @relation(fields: [inventoryCountId], references: [id], onDelete: Cascade)
  user           User           @relation("InventoryCountAssigneeUser", fields: [userId], references: [id], onDelete: Restrict)
  assignedBy     User           @relation("InventoryCountAssigneeAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)

  @@unique([inventoryCountId, userId], name: "inventory_count_assignee_unique")
  @@index([inventoryCountId])
  @@index([userId])
  @@index([assignedById])
  @@index([assignedAt])
}

model InventoryCountLocation {
  id               Int                          @id @default(autoincrement())
  inventoryCountId Int
  locationId       Int
  status           InventoryCountLocationStatus @default(PENDING)

  locationCode String

  startedAt   DateTime?
  completedAt DateTime?

  countedById   String?
  countedByName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventoryCount InventoryCount    @relation(fields: [inventoryCountId], references: [id], onDelete: Cascade)
  location       WarehouseLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  countedBy      User?             @relation("InventoryCountLocationCountedBy", fields: [countedById], references: [id], onDelete: SetNull)

  lines InventoryCountLine[]

  @@unique([inventoryCountId, locationId], name: "inventory_count_location_unique")
  @@index([inventoryCountId, status])
  @@index([locationId])
  @@index([countedById])
}

model InventoryCountLine {
  id                       Int                      @id @default(autoincrement())
  inventoryCountId         Int
  inventoryCountLocationId Int
  locationId               Int
  handlingUnitId           Int
  productId                Int
  status                   InventoryCountLineStatus @default(PENDING)

  locationCode        String
  handlingUnitBarcode String
  handlingUnitType    String
  productCode         String
  productBarcode      String
  productName         String

  systemQuantity      Int
  systemReservedStock Int @default(0)

  locationSystemQuantity Int
  locationReservedStock  Int @default(0)

  countedQuantity Int?
  difference      Int?
  isDiscovered    Boolean @default(false)

  countedById   String?
  countedByName String?
  countedAt     DateTime?
  note          String?

  handlingUnitUpdatedAt     DateTime?
  handlingUnitItemUpdatedAt DateTime?
  locationStockUpdatedAt    DateTime?

  appliedQuantityChange Int?
  approvedAt            DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventoryCount         InventoryCount         @relation(fields: [inventoryCountId], references: [id], onDelete: Cascade)
  inventoryCountLocation InventoryCountLocation @relation(fields: [inventoryCountLocationId], references: [id], onDelete: Cascade)
  location               WarehouseLocation      @relation(fields: [locationId], references: [id], onDelete: Restrict)
  handlingUnit           HandlingUnit           @relation(fields: [handlingUnitId], references: [id], onDelete: Restrict)
  product                Product                @relation(fields: [productId], references: [id], onDelete: Restrict)
  countedBy              User?                  @relation("InventoryCountLineCountedBy", fields: [countedById], references: [id], onDelete: SetNull)

  @@unique([inventoryCountId, locationId, handlingUnitId, productId], name: "inventory_count_line_unique")
  @@index([inventoryCountId, status])
  @@index([inventoryCountLocationId, status])
  @@index([locationId, productId])
  @@index([handlingUnitId, productId])
  @@index([productId])
  @@index([countedById])
  @@index([countedAt])
  @@index([approvedAt])
}

enum DataImportType {
  PRODUCT
  SUPPLIER
  CUSTOMER
  PURCHASE_ORDER
  SALES_ORDER
}

enum DataImportMode {
  CREATE_ONLY
  UPSERT
}

enum DataImportStatus {
  VALIDATING
  READY
  PROCESSING
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
}

enum DataImportRowStatus {
  VALID
  INVALID
  IMPORTED
  UPDATED
  SKIPPED
  FAILED
}

model DataImportJob {
  id           String           @id @default(cuid())
  importNumber String           @unique
  importType   DataImportType
  mode         DataImportMode   @default(CREATE_ONLY)
  status       DataImportStatus @default(VALIDATING)

  originalFileName String
  mimeType         String?
  fileSize         Int
  fileHash         String

  totalRows    Int @default(0)
  validRows    Int @default(0)
  invalidRows  Int @default(0)
  insertedRows Int @default(0)
  updatedRows  Int @default(0)
  skippedRows  Int @default(0)
  failedRows   Int @default(0)

  createdById   String
  createdByName String

  startedAt  DateTime?
  finishedAt DateTime?

  summary      Json?
  errorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rows DataImportRow[]

  @@index([importType, status, createdAt])
  @@index([createdById, createdAt])
  @@index([fileHash])
}

model DataImportRow {
  id String @id @default(cuid())

  jobId       String
  sheetName   String
  rowNumber   Int
  externalKey String?

  status DataImportRowStatus

  rawData        Json
  normalizedData Json?
  errors         Json?

  resultRecordId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  job DataImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, sheetName, rowNumber])
  @@index([jobId, status])
  @@index([externalKey])
}

enum CompetitorSourceType {
  MANUAL
  HTML
  API
  EXCEL
}

enum CompetitorStockStatus {
  UNKNOWN
  IN_STOCK
  OUT_OF_STOCK
  PREORDER
}

enum CompetitorPriceFetchStatus {
  SUCCESS
  PRODUCT_NOT_FOUND
  PRICE_NOT_FOUND
  BLOCKED
  INVALID_RESPONSE
  ERROR
}

enum CompetitorPriceRunStatus {
  PENDING
  RUNNING
  COMPLETED
  PARTIALLY_COMPLETED
  FAILED
}

model CompetitorSite {
  id Int @id @default(autoincrement())

  tenantId  String @default("tenant_etken")
  companyId String @default("company_etken_office")

  code    String
  name    String
  baseUrl String

  sourceType CompetitorSourceType @default(MANUAL)

  defaultVatRate Int?

  searchEnabled     Boolean @default(false)
  searchUrlTemplate String?
  productUrlPattern String?
  searchResultLimit Int     @default(10)

  isActive Boolean @default(true)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  competitorProducts CompetitorProduct[]
  priceRuns          CompetitorPriceRun[]

  @@unique([tenantId, companyId, code])
  @@index([tenantId, companyId, isActive])
  @@index([sourceType, isActive])
  @@index([searchEnabled, isActive])
}

model CompetitorProduct {
  id Int @id @default(autoincrement())

  tenantId  String @default("tenant_etken")
  companyId String @default("company_etken_office")

  productId        Int
  competitorSiteId Int

  competitorSku  String?
  competitorName String?
  productUrl     String

  vatRate Int?

  isActive Boolean @default(true)

  lastPriceExclVat Float?
  lastPriceInclVat Float?
  lastCurrency     String                @default("TRY")
  lastStockStatus  CompetitorStockStatus @default(UNKNOWN)

  lastCheckedAt DateTime?
  lastSuccessAt DateTime?
  lastError     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product        Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  competitorSite CompetitorSite @relation(fields: [competitorSiteId], references: [id], onDelete: Cascade)

  priceHistory CompetitorPriceHistory[]

  @@unique([competitorSiteId, productId])
  @@unique([competitorSiteId, productUrl])
  @@index([tenantId, companyId, isActive])
  @@index([productId, isActive])
  @@index([competitorSiteId, isActive])
  @@index([lastCheckedAt])
}

model CompetitorPriceHistory {
  id Int @id @default(autoincrement())

  competitorProductId Int
  priceRunId          Int?

  priceExclVat Float?
  priceInclVat Float?

  currency String @default("TRY")
  vatRate  Int?

  stockStatus CompetitorStockStatus      @default(UNKNOWN)
  fetchStatus CompetitorPriceFetchStatus

  rawPriceText String?
  errorMessage String?

  checkedAt DateTime @default(now())
  createdAt DateTime @default(now())

  competitorProduct CompetitorProduct   @relation(fields: [competitorProductId], references: [id], onDelete: Cascade)
  priceRun          CompetitorPriceRun? @relation(fields: [priceRunId], references: [id], onDelete: SetNull)

  @@index([competitorProductId, checkedAt])
  @@index([priceRunId])
  @@index([fetchStatus, checkedAt])
}

model CompetitorPriceRun {
  id Int @id @default(autoincrement())

  tenantId  String @default("tenant_etken")
  companyId String @default("company_etken_office")

  competitorSiteId Int?

  status CompetitorPriceRunStatus @default(PENDING)

  requestedCount Int @default(0)
  processedCount Int @default(0)
  successCount   Int @default(0)
  failedCount    Int @default(0)

  startedAt   DateTime?
  completedAt DateTime?

  errorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  competitorSite CompetitorSite?          @relation(fields: [competitorSiteId], references: [id], onDelete: SetNull)
  priceHistory   CompetitorPriceHistory[]

  @@index([tenantId, companyId, createdAt])
  @@index([competitorSiteId, createdAt])
  @@index([status, createdAt])
}
