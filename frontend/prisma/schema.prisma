model LogisticsCenter {
  id String @id @default(cuid())

  tenantId String

  code String
  name String

  address    String?
  city       String?
  district   String?
  postalCode String?

  phone String?
  email String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant     WmsTenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  warehouses Warehouse[]

  @@unique([tenantId, code], name: "logistics_center_tenant_code_unique")
  @@index([tenantId, isActive])
  @@index([name])
