generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id            Int      @id @default(autoincrement())
  tenantId      String   @default("tenant_etken")
  companyId     String   @default("company_etken_office")
  code          String   @unique
  barcode       String   @unique
  name          String
  brand         String
  category      String
  supplier      String
  imageUrl      String?
  price         Float
  stock         Int
  reservedStock Int      @default(0)
  vat           Int
  ownStock      Boolean
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  tenant                WmsTenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company               WmsCompany                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  warehouseStocks       WarehouseProductStock[]
  orderItems            OrderItem[]
  purchaseOrderItems    PurchaseOrderItem[]
  stockMovements        StockMovement[]
  locationStocks        WarehouseLocationStock[]
  handlingUnitItems     HandlingUnitItem[]
  pickingRecords        PickingRecord[]
  packingRecords        PackingRecord[]
  shippingUnitItems     ShippingHandlingUnitItem[]
  dispatchLines         DispatchDocumentLine[]
  inventoryCountLines   InventoryCountLine[]
  waveDistributionLines WaveDistributionLine[]
  competitorProducts    CompetitorProduct[]

  @@index([tenantId, companyId, isActive])
  @@index([companyId, code])
  @@index([companyId, barcode])
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Supplier {
  id              Int             @id @default(autoincrement())
  name            String          @unique
  taxOffice       String?
  taxNumber       String?         @unique
  contactName     String?
  phone           String?
  email           String?
  address         String?
  city            String?
  district        String?
  postalCode      String?
  paymentTermDays Int             @default(0)
  discountRate    Float           @default(0)
  deliveryDays    Int             @default(1)
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  purchaseOrders  PurchaseOrder[]
}

model Brand {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id                    Int                    @id @default(autoincrement())
  customerCode          String                 @unique
  companyName           String
  taxOffice             String?
  taxNumber             String?                @unique
  contactName           String?
  phone                 String?
  email                 String?
  address               String?
  city                  String?
  district              String?
  paymentTermDays       Int                    @default(0)
  discountRate          Float                  @default(0)
  creditLimit           Float                  @default(0)
  isActive              Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  addresses             CustomerAddress[]
  orders                Order[]
  accountEntries        CustomerAccountEntry[]
  users                 User[]
  waveDistributions     WaveDistribution[]
  shippingHandlingUnits ShippingHandlingUnit[]
}

model CustomerAddress {
  id                Int      @id @default(autoincrement())
  customerId        Int
  addressCode       String
  title             String
  addressType       String
  contactName       String?
  phone             String?
  address           String
  city              String
  district          String
  postalCode        String?
  deliveryStartTime String?
  deliveryEndTime   String?
  hasForklift       Boolean  @default(false)
  rampCount         Int      @default(0)
  vehicleType       String?
  description       String?
  isDefault         Boolean  @default(false)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  customer              Customer                    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orders                Order[]
  waveDistributions     WaveDistribution[]
  shippingHandlingUnits ShippingHandlingUnit[]
  userAccesses          CustomerUserAddressAccess[]

  @@unique([customerId, addressCode])
  @@index([customerId])
}

enum OrderStatus {
  DRAFT
  PENDING
  APPROVED
  PREPARING
  PICKING
  PACKING
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  CANCELLED
}

enum OrderSource {
  ADMIN
  B2B
  IMPORT
  API
}

enum B2BPaymentMethod {
  BANK_TRANSFER
  CURRENT_ACCOUNT
}

enum CustomerAccountEntryDirection {
  DEBIT
  CREDIT
}

enum CustomerAccountEntryType {
  OPENING_BALANCE
  ORDER
  PAYMENT
  ADJUSTMENT
  REFUND
  CANCELLATION
}

enum CustomerAccountPaymentMethod {
  MANUAL
  BANK_TRANSFER
  CASH
  CREDIT_CARD
  OTHER
}

model CustomerUserAddressAccess {
  userId       String
  addressId    Int
  assignedById String?
  createdAt    DateTime @default(now())

  user       User            @relation("CustomerUserAddressAccessUser", fields: [userId], references: [id], onDelete: Cascade)
  address    CustomerAddress @relation(fields: [addressId], references: [id], onDelete: Cascade)
  assignedBy User?           @relation("CustomerUserAddressAccessAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@id([userId, addressId])
  @@index([addressId])
  @@index([assignedById])
}

model Order {
  id                Int               @id @default(autoincrement())
  orderNumber       String            @unique
  customerId        Int
  shippingAddressId Int?
  status            OrderStatus       @default(PENDING)
  source            OrderSource       @default(ADMIN)
  paymentMethod     B2BPaymentMethod?
  placedByUserId    String?
  placedByUsername  String?
  orderDate         DateTime          @default(now())
  requestedDate     DateTime?
  paymentTermDays   Int               @default(0)
  discountRate      Float             @default(0)
  subtotal          Float             @default(0)
  discountAmount    Float             @default(0)
  vatAmount         Float             @default(0)
  totalAmount       Float             @default(0)
  customerNote      String?
  internalNote      String?
  stockReserved     Boolean           @default(false)
  stockDeducted     Boolean           @default(false)
  stockReservedAt   DateTime?
  stockDeductedAt   DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  customer                   Customer                    @relation(fields: [customerId], references: [id])
  shippingAddress            CustomerAddress?            @relation(fields: [shippingAddressId], references: [id])
  placedByUser               User?                       @relation("OrderPlacedByUser", fields: [placedByUserId], references: [id], onDelete: SetNull)
  items                      OrderItem[]
  statusHistory              OrderStatusHistory[]
  accountEntries             CustomerAccountEntry[]
  stockMovements             StockMovement[]
  pickingRecords             PickingRecord[]
  assignedHandlingUnits      HandlingUnit[]              @relation("AssignedHandlingUnits")
  waveOrders                 WaveOrder[]
  fulfillment                OrderFulfillment?
  waveDistributionOrders     WaveDistributionOrder[]
  waveDistributionLines      WaveDistributionLine[]
  shippingHandlingUnitOrders ShippingHandlingUnitOrder[]
  shippingHandlingUnitItems  ShippingHandlingUnitItem[]
  packingRecords             PackingRecord[]
  dispatchLines              DispatchDocumentLine[]

  @@index([customerId])
  @@index([shippingAddressId])
  @@index([placedByUserId])
  @@index([source, status])
  @@index([status])
  @@index([orderDate])
}

model B2BCompanyProfile {
  id Int @id @default(autoincrement())

  tenantId  String
  companyId String

  brandName           String
  legalName           String
  taxOffice           String?
  taxNumber           String?
  mersisNumber        String?
  tradeRegistryNumber String?
  authorizedPerson    String?

  phone        String?
  supportEmail String?
  email        String?
  kepAddress   String?
  website      String?

  addressLine String?
  city        String?
  district    String?
  postalCode  String?
  country     String  @default("Türkiye")

  workingHours String?
  logoUrl      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, companyId])
  @@index([tenantId, companyId])
}

model B2BBankAccount {
  id Int @id @default(autoincrement())

  tenantId  String
  companyId String

  bankName      String
  branchName    String?
  accountHolder String
  iban          String
  currency      String  @default("TRY")

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, companyId, iban])
  @@index([tenantId, companyId, isActive])
}

model CustomerAccountEntry {
  id Int @id @default(autoincrement())

  customerId Int
  orderId    Int?

  direction     CustomerAccountEntryDirection
  entryType     CustomerAccountEntryType
  paymentMethod CustomerAccountPaymentMethod?

  amount      Float
  currency    String  @default("TRY")
  description String
  referenceNo String?

  transactionDate DateTime  @default(now())
  dueDate         DateTime?

  createdByUserId   String?
  createdByUsername String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  order    Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([orderId, entryType, direction])
  @@index([customerId, transactionDate])
  @@index([customerId, dueDate])
  @@index([customerId, direction])
  @@index([orderId])
}

model OrderStatusHistory {
  id      Int         @id @default(autoincrement())
  orderId Int
  status  OrderStatus

  note              String?
  changedByUserId   String?
  changedByUsername String?
  visibleToCustomer Boolean  @default(true)
  createdAt         DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([orderId, visibleToCustomer])
}

model OrderItem {
  id              Int      @id @default(autoincrement())
  orderId         Int
  productId       Int
  productCode     String
  productName     String
  quantity        Int
  pickedQuantity  Int      @default(0)
  packedQuantity  Int      @default(0)
  shippedQuantity Int      @default(0)
  unitPrice       Float
  vatRate         Int
  lineNet         Float
  vatAmount       Float
  lineTotal       Float
  createdAt       DateTime @default(now())

  order                     Order                      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product                   Product                    @relation(fields: [productId], references: [id])
  pickingRecords            PickingRecord[]
  waveDistributionLines     WaveDistributionLine[]
  shippingHandlingUnitItems ShippingHandlingUnitItem[]
  packingRecords            PackingRecord[]
  dispatchLines             DispatchDocumentLine[]

  @@index([orderId])
  @@index([productId])
  @@index([pickedQuantity])
  @@index([packedQuantity])
  @@index([shippedQuantity])
}

enum PurchaseOrderStatus {
  DRAFT
  PENDING
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id              Int                 @id @default(autoincrement())
  purchaseNumber  String              @unique
  supplierId      Int
  status          PurchaseOrderStatus @default(DRAFT)
  orderDate       DateTime            @default(now())
  expectedDate    DateTime?
  paymentTermDays Int                 @default(0)
  discountRate    Float               @default(0)
  subtotal        Float               @default(0)
  discountAmount  Float               @default(0)
  vatAmount       Float               @default(0)
  totalAmount     Float               @default(0)
  supplierNote    String?
  internalNote    String?
  approvedAt      DateTime?
  receivedAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  supplier       Supplier            @relation(fields: [supplierId], references: [id])
  items          PurchaseOrderItem[]
  stockMovements StockMovement[]

  @@index([supplierId])
  @@index([status])
  @@index([orderDate])
  @@index([expectedDate])
}

model PurchaseOrderItem {
  id               Int      @id @default(autoincrement())
  purchaseOrderId  Int
  productId        Int
  productCode      String
  productName      String
  orderedQuantity  Int
  receivedQuantity Int      @default(0)
  unitPrice        Float
  vatRate          Int
  lineNet          Float
  vatAmount        Float
  lineTotal        Float
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])

  @@index([purchaseOrderId])
  @@index([productId])
}

enum StockMovementType {
  INITIAL_STOCK
  PURCHASE_RECEIPT
  MANUAL_IN
  MANUAL_OUT
  RESERVATION_CREATE
  RESERVATION_RELEASE
  SALE_SHIPMENT
  SALE_RETURN
  COUNT_INCREASE
  COUNT_DECREASE
  TRANSFER_IN
  TRANSFER_OUT
}

model StockMovement {
  id                     Int               @id @default(autoincrement())
  tenantId               String            @default("tenant_etken")
  companyId              String            @default("company_etken_office")
  warehouseId            Int?
  productId              Int
  orderId                Int?
  purchaseOrderId        Int?
  shippingHandlingUnitId String?
  movementType           StockMovementType
  physicalChange         Int               @default(0)
  reservedChange         Int               @default(0)
  physicalBalanceAfter   Int
  reservedBalanceAfter   Int
  availableBalanceAfter  Int
  documentNumber         String?
  description            String?
  createdAt              DateTime          @default(now())

  tenant               WmsTenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company              WmsCompany            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  warehouse            Warehouse?            @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  product              Product               @relation(fields: [productId], references: [id])
  order                Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)
  purchaseOrder        PurchaseOrder?        @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  shippingHandlingUnit ShippingHandlingUnit? @relation(fields: [shippingHandlingUnitId], references: [id], onDelete: SetNull)

  @@index([tenantId, companyId, warehouseId])
  @@index([companyId, productId, createdAt])
  @@index([warehouseId, productId, createdAt])
  @@index([productId])
  @@index([orderId])
  @@index([purchaseOrderId])
  @@index([shippingHandlingUnitId])
  @@index([movementType])
  @@index([createdAt])
}

enum WarehouseLocationType {
  PALLET
  BOX
  HANGING
  FLOOR
  RETURN
  QUALITY
  RFID
  SHIPPING
  RECEIVING
  QUARANTINE
}

model Warehouse {
  id                Int      @id @default(autoincrement())
  tenantId          String   @default("tenant_etken")
  companyId         String   @default("company_etken_office")
  logisticsCenterId String   @default("logistics_center_etken")
  code              String   @unique
  name              String
  address           String?
  city              String?
  district          String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant          WmsTenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company         WmsCompany      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  logisticsCenter LogisticsCenter @relation(fields: [logisticsCenterId], references: [id], onDelete: Restrict)

  locations       WarehouseLocation[]
  handlingUnits   HandlingUnit[]
  productStocks   WarehouseProductStock[]
  stockMovements  StockMovement[]
  inventoryCounts InventoryCount[]
  userAccesses    UserWarehouseAccess[]

  @@index([tenantId])
  @@index([companyId])
  @@index([logisticsCenterId])
  @@index([tenantId, companyId, isActive])
}

model WarehouseLocation {
  id                      Int                      @id @default(autoincrement())
  warehouseId             Int
  code                    String
  aisle                   String                   @default("")
  section                 String                   @default("")
  level                   String                   @default("")
  bin                     String                   @default("")
  locationType            WarehouseLocationType    @default(PALLET)
  capacity                Int                      @default(1)
  sortOrder               Int                      @default(0)
  description             String?
  isActive                Boolean                  @default(true)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  stocks                  WarehouseLocationStock[]
  handlingUnits           HandlingUnit[]
  inventoryCountLocations InventoryCountLocation[]
  inventoryCountLines     InventoryCountLine[]

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, code, aisle, section, level, bin], name: "warehouse_location_position_unique")
  @@index([warehouseId])
  @@index([code])
  @@index([aisle])
  @@index([locationType])
  @@index([isActive])
  @@index([sortOrder])
}

model WarehouseLocationStock {
  id            Int      @id @default(autoincrement())
  locationId    Int
  productId     Int
  quantity      Int      @default(0)
  reservedStock Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  location WarehouseLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  product  Product           @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([locationId, productId], name: "location_product_unique")
  @@index([locationId])
  @@index([productId])
  @@index([quantity])
}

model WarehouseProductStock {
  id            Int      @id @default(autoincrement())
  tenantId      String   @default("tenant_etken")
  companyId     String   @default("company_etken_office")
  warehouseId   Int
  productId     Int
  physicalStock Int      @default(0)
  reservedStock Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant    WmsTenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company   WmsCompany @relation(fields: [companyId], references: [id], onDelete: Restrict)
  warehouse Warehouse  @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  product   Product    @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([warehouseId, productId], name: "warehouse_product_stock_unique")
  @@index([tenantId, companyId, warehouseId])
  @@index([companyId, productId])
  @@index([warehouseId, physicalStock])
  @@index([warehouseId, reservedStock])
}

enum HandlingUnitPurpose {
  STOCK
  PICKING
  PACKING
  SHIPPING
  RECEIVING
}

enum HandlingUnitType {
  PALLET
  BOX
  PICKING_PALLET
  PICKING_BOX
}

enum HandlingUnitStatus {
  OPEN
  CLOSED
  STORED
  IN_TRANSIT
  EMPTY
  CANCELLED
}

model HandlingUnit {
  id              Int                 @id @default(autoincrement())
  tenantId        String              @default("tenant_etken")
  companyId       String              @default("company_etken_office")
  barcode         String              @unique
  unitType        HandlingUnitType
  purpose         HandlingUnitPurpose @default(STOCK)
  status          HandlingUnitStatus  @default(OPEN)
  warehouseId     Int?
  locationId      Int?
  parentUnitId    Int?
  assignedOrderId Int?
  assignedWaveId  String?
  description     String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  tenant    WmsTenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company   WmsCompany         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  warehouse Warehouse?         @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  location  WarehouseLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  parentUnit HandlingUnit?  @relation("HandlingUnitHierarchy", fields: [parentUnitId], references: [id], onDelete: SetNull)
  childUnits HandlingUnit[] @relation("HandlingUnitHierarchy")

  assignedOrder Order? @relation("AssignedHandlingUnits", fields: [assignedOrderId], references: [id], onDelete: SetNull)
  assignedWave  Wave?  @relation("AssignedWaveHandlingUnits", fields: [assignedWaveId], references: [id], onDelete: SetNull)

  items HandlingUnitItem[]

  sourcePickingRecords PickingRecord[]       @relation("PickingSourceHandlingUnit")
  targetPickingRecords PickingRecord[]       @relation("PickingTargetHandlingUnit")
  sourcePackingRecords PackingRecord[]       @relation("PackingSourceHandlingUnit")
  targetPackingRecords PackingRecord[]       @relation("PackingTargetHandlingUnit")
  shippingProfile      ShippingHandlingUnit?
  inventoryCountLines  InventoryCountLine[]

  @@index([tenantId, companyId, warehouseId])
  @@index([companyId, barcode])
  @@index([barcode])
  @@index([unitType])
  @@index([purpose])
  @@index([status])
  @@index([warehouseId])
  @@index([locationId])
  @@index([parentUnitId])
  @@index([assignedOrderId])
  @@index([assignedWaveId])
}

model HandlingUnitItem {
  id             Int      @id @default(autoincrement())
  handlingUnitId Int
  productId      Int
  quantity       Int      @default(0)
  reservedStock  Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  handlingUnit HandlingUnit @relation(fields: [handlingUnitId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([handlingUnitId, productId], name: "handling_unit_product_unique")
  @@index([handlingUnitId])
  @@index([productId])
  @@index([quantity])
}

model PickingRecord {
  id                   Int                  @id @default(autoincrement())
  orderId              Int
  orderItemId          Int
  productId            Int
  sourceHandlingUnitId Int
  targetHandlingUnitId Int
  waveId               String?
  flowType             OrderFulfillmentFlow @default(DIRECT_ORDER)
  quantity             Int
  sourceQuantityAfter  Int
  targetQuantityAfter  Int
  createdAt            DateTime             @default(now())

  order              Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem          OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  product            Product      @relation(fields: [productId], references: [id])
  sourceHandlingUnit HandlingUnit @relation("PickingSourceHandlingUnit", fields: [sourceHandlingUnitId], references: [id])
  targetHandlingUnit HandlingUnit @relation("PickingTargetHandlingUnit", fields: [targetHandlingUnitId], references: [id])
  wave               Wave?        @relation(fields: [waveId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([orderItemId])
  @@index([productId])
  @@index([sourceHandlingUnitId])
  @@index([targetHandlingUnitId])
  @@index([waveId])
  @@index([flowType])
  @@index([createdAt])
}

/**
 * WMS İŞLEM VE HAREKET KAYITLARI
 * RF ve yönetim ekranlarında gerçekleştirilen depo işlemlerinin
 * ortak hareket geçmişini tutar.
 * Mevcut sistemde kullanıcı modeli bulunmadığı için operatorId,
 * operatorName ve terminalCode alanları metin olarak tutulur.
 */

enum WmsOperationType {
  RECEIVING
  HANDLING_UNIT_CREATE
  HANDLING_UNIT_UPDATE
  HANDLING_UNIT_CANCEL
  ADDRESSING
  UNADDRESSING
  ITEM_TRANSFER
  FULL_TRANSFER
  PALLET_LINK
  PALLET_UNLINK
  PICKING
  PACKING
  SHIPPING
  COUNT
  STOCK_IN
  STOCK_OUT
  OTHER
}

model WmsOperationLog {
  id Int @id @default(autoincrement())

  operationType WmsOperationType

  /**
   * İşlemin yapıldığı modül.
   * Örnekler:
   * RF_RECEIVING
   * RF_PICKING
   * RF_TRANSFER
   * ADMIN_HANDLING_UNIT
   */
  module String

  /**
   * İşlemin ana kayıt tipi ve kimliği.
   * Örnek:
   * entityType = HANDLING_UNIT
   * entityId   = 125
   */
  entityType String?
  entityId   Int?

  /**
   * Kullanıcı ve RF terminal bilgileri.
   * Kullanıcı altyapısı eklendiğinde operatorId alanı
   * kullanıcı kaydıyla ilişkilendirilebilir.
   */
  operatorId   String?
  operatorName String?
  terminalCode String?
  ipAddress    String?

  /**
   * İşlemle ilgili barkodlar.
   * barcode       = ana THM veya belge barkodu
   * sourceBarcode = kaynak THM
   * targetBarcode = hedef THM
   */
  barcode       String?
  sourceBarcode String?
  targetBarcode String?

  /**
   * Sipariş ve satın alma belgesi bilgileri.
   */
  orderId         Int?
  orderNumber     String?
  purchaseOrderId Int?
  purchaseNumber  String?

  /**
   * Ürün bilgileri.
   */
  productId   Int?
  productCode String?
  productName String?
  quantity    Int?

  /**
   * Depo ve lokasyon bilgileri.
   */
  warehouseId   Int?
  warehouseCode String?

  sourceLocationId   Int?
  sourceLocationCode String?

  targetLocationId   Int?
  targetLocationCode String?

  /**
   * İşlem öncesi ve sonrası durumlar.
   */
  previousStatus String?
  newStatus      String?

  /**
   * Serbest açıklama ve ilave teknik bilgi.
   * metadata örneği:
   * {
   * "sourceQuantityBefore": 10,
   * "sourceQuantityAfter": 6,
   * "targetQuantityBefore": 2,
   * "targetQuantityAfter": 6
   * }
   */
  description String?
  metadata    Json?

  /**
   * İşlem başarılı mı?
   * Başarısız RF girişimleri veya kullanıcı hataları da
   * ileride bu tabloya kaydedilebilir.
   */
  isSuccessful Boolean @default(true)
  errorMessage String?

  createdAt DateTime @default(now())

  @@index([operationType])
  @@index([module])
  @@index([entityType, entityId])
  @@index([operatorId])
  @@index([operatorName])
  @@index([terminalCode])
  @@index([barcode])
  @@index([sourceBarcode])
  @@index([targetBarcode])
  @@index([orderId])
  @@index([orderNumber])
  @@index([purchaseOrderId])
  @@index([purchaseNumber])
  @@index([productId])
  @@index([productCode])
  @@index([warehouseId])
  @@index([sourceLocationId])
  @@index([targetLocationId])
  @@index([isSuccessful])
  @@index([createdAt])
}

// Bu blok mevcut prisma/schema.prisma dosyasının SONUNA eklenmelidir.
// Mevcut generator, datasource ve modeller silinmemelidir.

enum WaveStatus {
  DRAFT
  READY
  RELEASED
  IN_PROGRESS
  PAUSED
  COMPLETED
  CANCELLED
}

enum WavePriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum WaveType {
  STORE_REPLENISHMENT
  CUSTOMER_ORDER
  ECOMMERCE
  TRANSFER
  MIXED
}

enum WaveAssignmentStatus {
  ASSIGNED
  ACTIVE
  WAITING
  COMPLETED
  CANCELLED
}

model Wave {
  id       String       @id @default(cuid())
  waveNo   String       @unique
  name     String?
  type     WaveType     @default(MIXED)
  status   WaveStatus   @default(DRAFT)
  priority WavePriority @default(NORMAL)

  plannedStartAt  DateTime?
  plannedFinishAt DateTime?
  releasedAt      DateTime?
  startedAt       DateTime?
  pausedAt        DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?

  plannedOrderCount Int @default(0)
  plannedLineCount  Int @default(0)
  plannedQuantity   Int @default(0)

  completedOrderCount Int @default(0)
  completedLineCount  Int @default(0)
  completedQuantity   Int @default(0)

  pickingProgress       Int @default(0)
  transferProgress      Int @default(0)
  consolidationProgress Int @default(0)
  packingProgress       Int @default(0)
  shippingProgress      Int @default(0)

  notes     String?
  createdBy String?
  updatedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders            WaveOrder[]
  assignments       WaveAssignment[]
  distributions     WaveDistribution[]
  handlingUnits     HandlingUnit[]     @relation("AssignedWaveHandlingUnits")
  orderFulfillments OrderFulfillment[]
  pickingRecords    PickingRecord[]

  @@index([status, priority])
  @@index([plannedStartAt])
  @@index([createdAt])
}

model WaveOrder {
  id      String @id @default(cuid())
  waveId  String
  orderId Int

  /**
   * Sipariş numarası ve müşteri bilgileri operasyon anındaki
   * tarihsel görüntüyü korumak için snapshot olarak tutulur.
   */
  orderNumber  String
  customerCode String?
  customerName String?
  storeCode    String?
  storeName    String?

  lineCount         Int @default(0)
  plannedQuantity   Int @default(0)
  completedQuantity Int @default(0)

  isCompleted Boolean   @default(false)
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wave              Wave                   @relation(fields: [waveId], references: [id], onDelete: Cascade)
  order             Order                  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  distributionOrder WaveDistributionOrder?

  /**
   * Bir sipariş aynı Wave'e ikinci kez eklenemez.
   */
  @@unique([waveId, orderId], name: "wave_order_unique")
  @@index([orderId])
  @@index([orderNumber])
  @@index([waveId, isCompleted])
}

enum OrderFulfillmentFlow {
  DIRECT_ORDER
  WAVE
}

enum FulfillmentProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  PARTIALLY_COMPLETED
  COMPLETED
  CANCELLED
}

enum WaveDistributionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ShippingHandlingUnitStatus {
  OPEN
  CLOSED
  READY_TO_SHIP
  SHIPPED
  CANCELLED
}

enum DispatchDocumentStatus {
  DRAFT
  READY
  ISSUED
  CANCELLED
}

model OrderFulfillment {
  id      String  @id @default(cuid())
  orderId Int     @unique
  waveId  String?

  flowType OrderFulfillmentFlow @default(DIRECT_ORDER)

  pickingStatus  FulfillmentProgressStatus @default(NOT_STARTED)
  packingStatus  FulfillmentProgressStatus @default(NOT_STARTED)
  shippingStatus FulfillmentProgressStatus @default(NOT_STARTED)

  plannedQuantity Int @default(0)
  pickedQuantity  Int @default(0)
  packedQuantity  Int @default(0)
  shippedQuantity Int @default(0)

  pickingStartedAt    DateTime?
  pickingCompletedAt  DateTime?
  packingStartedAt    DateTime?
  packingCompletedAt  DateTime?
  shippingStartedAt   DateTime?
  shippingCompletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  wave Wave? @relation(fields: [waveId], references: [id], onDelete: SetNull)

  @@index([waveId])
  @@index([flowType])
  @@index([pickingStatus])
  @@index([packingStatus])
  @@index([shippingStatus])
  @@index([updatedAt])
}

model WaveDistribution {
  id     String @id @default(cuid())
  waveId String

  sequenceNumber   Int
  distributionCode String @unique
  groupKey         String

  status WaveDistributionStatus @default(PLANNED)

  customerId        Int
  shippingAddressId Int?

  customerCode String?
  customerName String
  taxOffice    String?
  taxNumber    String?

  addressTitle String?
  contactName  String?
  phone        String?
  address      String
  city         String
  district     String
  postalCode   String?

  plannedOrderCount Int @default(0)
  plannedLineCount  Int @default(0)
  plannedQuantity   Int @default(0)
  packedQuantity    Int @default(0)
  shippedQuantity   Int @default(0)

  startedAt   DateTime?
  completedAt DateTime?
  cancelledAt DateTime?

  createdById   String?
  createdByName String?
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wave Wave @relation(fields: [waveId], references: [id], onDelete: Cascade)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  shippingAddress CustomerAddress? @relation(fields: [shippingAddressId], references: [id], onDelete: SetNull)

  orders         WaveDistributionOrder[]
  lines          WaveDistributionLine[]
  shippingUnits  ShippingHandlingUnit[]
  packingRecords PackingRecord[]

  @@unique([waveId, sequenceNumber], name: "wave_distribution_sequence_unique")
  @@unique([waveId, groupKey], name: "wave_distribution_group_unique")
  @@index([waveId, status])
  @@index([customerId])
  @@index([shippingAddressId])
  @@index([distributionCode])
  @@index([createdAt])
}

model WaveDistributionOrder {
  id             String @id @default(cuid())
  distributionId String
  waveOrderId    String @unique
  orderId        Int

  orderNumber String

  plannedQuantity Int @default(0)
  packedQuantity  Int @default(0)
  shippedQuantity Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  distribution WaveDistribution @relation(fields: [distributionId], references: [id], onDelete: Cascade)

  waveOrder WaveOrder @relation(fields: [waveOrderId], references: [id], onDelete: Restrict)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  lines WaveDistributionLine[]

  @@unique([distributionId, orderId], name: "wave_distribution_order_unique")
  @@index([distributionId])
  @@index([orderId])
  @@index([orderNumber])
}

model WaveDistributionLine {
  id                  String @id @default(cuid())
  distributionId      String
  distributionOrderId String
  orderId             Int
  orderItemId         Int
  productId           Int

  productCode    String
  productBarcode String
  productName    String

  plannedQuantity Int
  packedQuantity  Int @default(0)
  shippedQuantity Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  distribution WaveDistribution @relation(fields: [distributionId], references: [id], onDelete: Cascade)

  distributionOrder WaveDistributionOrder @relation(fields: [distributionOrderId], references: [id], onDelete: Cascade)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  packingRecords PackingRecord[]

  @@unique([distributionId, orderItemId], name: "wave_distribution_line_unique")
  @@index([distributionOrderId])
  @@index([orderId])
  @@index([orderItemId])
  @@index([productId])
  @@index([productCode])
}

model BarcodePrinter {
  id String @id @default(cuid())

  code String @unique
  name String

  ipAddress String
  port      Int    @default(9100)

  dpi Int @default(203)

  labelWidthMm  Int @default(100)
  labelHeightMm Int @default(100)

  commandLanguage String @default("ZPL")

  isActive Boolean @default(true)

  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([name])
  @@index([ipAddress])
}

model ShippingHandlingUnit {
  id             String @id @default(cuid())
  handlingUnitId Int    @unique

  status ShippingHandlingUnitStatus @default(OPEN)

  packageSequence Int @default(1)

  waveDistributionId String?

  customerId        Int
  shippingAddressId Int?

  customerCode String?
  customerName String
  taxOffice    String?
  taxNumber    String?

  addressTitle String?
  contactName  String?
  phone        String?
  address      String
  city         String
  district     String
  postalCode   String?

  grossWeightKg Float?
  netWeightKg   Float?
  lengthCm      Float?
  widthCm       Float?
  heightCm      Float?

  labelPrintedAt DateTime?

  packingListPrintedAt       DateTime?
  packingListPrintCount      Int       @default(0)
  packingListLastPrinterCode String?

  closedAt    DateTime?
  readyAt     DateTime?
  shippedAt   DateTime?
  cancelledAt DateTime?

  createdById   String?
  createdByName String?
  closedById    String?
  closedByName  String?
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  handlingUnit HandlingUnit @relation(fields: [handlingUnitId], references: [id], onDelete: Restrict)

  waveDistribution WaveDistribution? @relation(fields: [waveDistributionId], references: [id], onDelete: SetNull)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  shippingAddress CustomerAddress? @relation(fields: [shippingAddressId], references: [id], onDelete: SetNull)

  orders ShippingHandlingUnitOrder[]
  items  ShippingHandlingUnitItem[]

  packingRecords PackingRecord[]

  dispatchDocument DispatchDocument?

  stockMovements StockMovement[]

  @@unique([waveDistributionId, packageSequence], name: "wave_distribution_package_sequence_unique")
  @@index([status])
  @@index([waveDistributionId])
  @@index([customerId])
  @@index([shippingAddressId])
  @@index([createdAt])
  @@index([closedAt])
  @@index([shippedAt])
  @@index([packingListPrintedAt])
  @@index([packingListLastPrinterCode])
}

model ShippingHandlingUnitOrder {
  id                     String @id @default(cuid())
  shippingHandlingUnitId String
  orderId                Int

  orderNumber String

  plannedQuantity Int @default(0)
  packedQuantity  Int @default(0)
  shippedQuantity Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shippingHandlingUnit ShippingHandlingUnit @relation(fields: [shippingHandlingUnitId], references: [id], onDelete: Cascade)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  items ShippingHandlingUnitItem[]

  @@unique([shippingHandlingUnitId, orderId], name: "shipping_handling_unit_order_unique")
  @@index([orderId])
  @@index([orderNumber])
}

model ShippingHandlingUnitItem {
  id                          String @id @default(cuid())
  shippingHandlingUnitId      String
  shippingHandlingUnitOrderId String
  orderId                     Int
  orderItemId                 Int
  productId                   Int

  productCode    String
  productBarcode String
  productName    String

  quantity        Int @default(0)
  shippedQuantity Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shippingHandlingUnit ShippingHandlingUnit @relation(fields: [shippingHandlingUnitId], references: [id], onDelete: Cascade)

  shippingHandlingUnitOrder ShippingHandlingUnitOrder @relation(fields: [shippingHandlingUnitOrderId], references: [id], onDelete: Cascade)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  dispatchLine DispatchDocumentLine?

  @@unique([shippingHandlingUnitId, orderItemId], name: "shipping_handling_unit_item_unique")
  @@index([shippingHandlingUnitOrderId])
  @@index([orderId])
  @@index([orderItemId])
  @@index([productId])
  @@index([productCode])
}

model PackingRecord {
  id Int @id @default(autoincrement())

  waveDistributionId     String?
  waveDistributionLineId String?
  shippingHandlingUnitId String

  orderId     Int
  orderItemId Int
  productId   Int

  sourceHandlingUnitId Int
  targetHandlingUnitId Int

  quantity            Int
  sourceQuantityAfter Int
  targetQuantityAfter Int

  operatorId   String?
  operatorName String?
  terminalCode String?

  createdAt DateTime @default(now())

  waveDistribution WaveDistribution? @relation(fields: [waveDistributionId], references: [id], onDelete: SetNull)

  waveDistributionLine WaveDistributionLine? @relation(fields: [waveDistributionLineId], references: [id], onDelete: SetNull)

  shippingHandlingUnit ShippingHandlingUnit @relation(fields: [shippingHandlingUnitId], references: [id], onDelete: Restrict)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  sourceHandlingUnit HandlingUnit @relation("PackingSourceHandlingUnit", fields: [sourceHandlingUnitId], references: [id], onDelete: Restrict)

  targetHandlingUnit HandlingUnit @relation("PackingTargetHandlingUnit", fields: [targetHandlingUnitId], references: [id], onDelete: Restrict)

  @@index([waveDistributionId])
  @@index([waveDistributionLineId])
  @@index([shippingHandlingUnitId])
  @@index([orderId])
  @@index([orderItemId])
  @@index([productId])
  @@index([sourceHandlingUnitId])
  @@index([targetHandlingUnitId])
  @@index([operatorId])
  @@index([createdAt])
}

model DispatchDocument {
  id                     String @id @default(cuid())
  shippingHandlingUnitId String @unique

  status DispatchDocumentStatus @default(DRAFT)

  dispatchNumber String? @unique
  ettn           String? @unique

  documentDate DateTime?
  shipmentAt   DateTime?

  recipientCode       String?
  recipientName       String
  recipientTaxOffice  String?
  recipientTaxNumber  String?
  recipientAddress    String
  recipientCity       String
  recipientDistrict   String
  recipientPostalCode String?

  carrierName          String?
  vehiclePlate         String?
  driverName           String?
  driverIdentityNumber String?

  issuedAt    DateTime?
  cancelledAt DateTime?

  createdById   String?
  createdByName String?

  issuedById   String?
  issuedByName String?

  cancelledById   String?
  cancelledByName String?
  cancelReason    String?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shippingHandlingUnit ShippingHandlingUnit @relation(fields: [shippingHandlingUnitId], references: [id], onDelete: Restrict)

  lines DispatchDocumentLine[]

  @@index([status])
  @@index([documentDate])
  @@index([shipmentAt])
  @@index([issuedAt])
  @@index([createdAt])
}

model DispatchDocumentLine {
  id                         String @id @default(cuid())
  dispatchDocumentId         String
  shippingHandlingUnitItemId String @unique

  orderId     Int
  orderItemId Int
  productId   Int

  orderNumber    String
  productCode    String
  productBarcode String
  productName    String

  quantity Int
  unit     String @default("ADET")

  createdAt DateTime @default(now())

  dispatchDocument DispatchDocument @relation(fields: [dispatchDocumentId], references: [id], onDelete: Cascade)

  shippingHandlingUnitItem ShippingHandlingUnitItem @relation(fields: [shippingHandlingUnitItemId], references: [id], onDelete: Restrict)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([dispatchDocumentId])
  @@index([orderId])
  @@index([orderItemId])
  @@index([productId])
  @@index([orderNumber])
  @@index([productCode])
}

model WmsTenant {
  id String @id @default(cuid())

  code String @unique
  name String

  legalName String?
  taxOffice String?
  taxNumber String?

  phone String?
  email String?

  address    String?
  city       String?
  district   String?
  postalCode String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companies         WmsCompany[]
  logisticsCenters  LogisticsCenter[]
  warehouses        Warehouse[]
  products          Product[]
  productStocks     WarehouseProductStock[]
  stockMovements    StockMovement[]
  handlingUnits     HandlingUnit[]
  memberships       WmsTenantMembership[]
  companyAccesses   UserCompanyAccess[]
  warehouseAccesses UserWarehouseAccess[]

  @@index([name])
  @@index([isActive])
}

model WmsCompany {
  id String @id @default(cuid())

  tenantId String

  code String
  name String

  legalName String?
  taxOffice String?
  taxNumber String?

  phone       String?
  email       String?
  contactName String?

  address    String?
  city       String?
  district   String?
  postalCode String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant WmsTenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  warehouses     Warehouse[]
  products       Product[]
  productStocks  WarehouseProductStock[]
  stockMovements StockMovement[]
  handlingUnits  HandlingUnit[]
  userAccesses   UserCompanyAccess[]

