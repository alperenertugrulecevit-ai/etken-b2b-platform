{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "lint:tests": "eslint tests vitest.config.mts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "quality": "npm run lint:tests && npx tsc --noEmit && npm run test:coverage && npm run build"
  },
  "dependencies": {
